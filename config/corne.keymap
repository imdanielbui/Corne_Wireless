#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 10

#include "dt-bindings/zmk/bt.h"
#include "dt-bindings/zmk/keys.h"
#include "dt-bindings/zmk/pointing.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include "duy_matrix9_corne42_zmk.dtsi"

/ {
    behaviors {
        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <0 12 24 25 13 1 2 14 26 27 15 3 4 16 28 29 17 5 36 37 38 39 40 41 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;
            hold-trigger-on-release;
        };

        mcla: mcla {
            compatible = "zmk,behavior-hold-tap";
            label = "MCLA";
            #binding-cells = <2>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <0>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;
            hold-trigger-on-release;
            bindings = <&mkp>, <&mkp>;

            tapping-term-ms = <280>;
        };

        et: et {
            compatible = "zmk,behavior-hold-tap";
            label = "ET";
            #binding-cells = <2>;
            bindings = <&kp>, <&hmr>;

            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            hold-trigger-key-positions = <38>;
        };

        cadlt: cadlt {
            compatible = "zmk,behavior-hold-tap";
            label = "CAD_LAYER_TAP";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;

            /* Tap sends Win; holding and pressing another key opens CAD. */

            tapping-term-ms = <220>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <0>;
            flavor = "balanced";
        };

        lower_layer: lower_layer {
            compatible = "zmk,behavior-hold-tap";
            label = "LOWER_LAYER";
            bindings = <&mo>, <&sl>;

            #binding-cells = <2>;
            tapping-term-ms = <220>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <0>;
            flavor = "balanced";
        };
    };

    combos {
        compatible = "zmk,combos";

        Layer_BL {
            bindings = <&sl 4>;
            key-positions = <37 40>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp TAB         &kp Q  &hmr LG(W) W  &kp E         &kp R             &hmr LG(T) T                       &kp Y      &kp U   &kp I          &kp O    &hmr F12 P  &kp BSPC
&kp LEFT_SHIFT  &kp A  &kp S         &kp D         &kp F             &kp G                              &kp H      &kp J   &kp K          &kp L    &kp SEMI    &kp SQT
&kp LCTRL       &kp Z  &kp X         &kp C         &kp V             &kp B                              &kp N      &kp M   &kp COMMA      &kp DOT  &kp FSLH    &hmr CAPSLOCK ESC
                                     &kp LEFT_WIN  &lower_layer 1 3  &hmr LS(LA(LC(LEFT_GUI))) ENTER    &kp SPACE  &tog 2  &kp RIGHT_ALT
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp TAB  &hmr LG(LS(N1)) NUMBER_1  &hmr LG(LS(N2)) N2  &hmr LG(LS(N3)) N3  &hmr LG(LS(N4)) N4  &hmr LG(LS(N5)) N5       &kp N6           &kp N7         &kp N8       &kp N9           &kp N0             &kp DEL
&trans   &hmr END HOME             &kp GRAVE           &kp MINUS           &kp EQUAL           &kp NON_US_BACKSLASH     &kp LEFT_ARROW   &kp DOWN       &kp UP       &kp RIGHT        &kp LBKT           &kp RBKT
&trans   &kp LG(Z)                 &kp LG(X)           &kp LG(C)           &kp LG(V)           &kp LC(LS(LA(LG(B))))    &kp PRINTSCREEN  &kp PAGE_DOWN  &kp PAGE_UP  &kp C_VOLUME_UP  &kp C_VOLUME_DOWN  &kp K_MUTE
                                                       &trans              &trans              &trans                   &trans           &trans         &trans
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&hmr F12 LC(TAB)  &kp F1            &kp F2     &kp F3        &kp F4     &kp F5             &kp F6           &kp F7          &kp F8         &kp F9           &kp F10  &kp F11
&trans            &mkp MB4          &mkp MB5   &mkp LCLK     &mkp RCLK  &mkp MCLK          &mmv MOVE_LEFT   &mmv MOVE_DOWN  &mmv MOVE_UP   &mmv MOVE_RIGHT  &trans   &trans
&trans            &hmr LG(Y) LG(Z)  &kp LG(X)  &kp LG(C)     &kp LG(V)  &kp PRINTSCREEN    &msc SCRL_LEFT   &msc SCRL_DOWN  &msc SCRL_UP   &msc SCRL_RIGHT  &trans   &hmr CAPSLOCK ESC
                                               &kp LEFT_GUI  &trans     &trans             &mcla RCLK LCLK  &trans          &kp RIGHT_ALT
            >;
        };

        cad_layer {
            // Hold the left Win thumb key to use this layer.
            // Left half is prioritized so the right hand can stay on the mouse.
            // -----------------------------------------------------------------------------------------
            // | ZS   | RR | PP | GLD | GOC | GCU |   | GGD | HAL | PVL | MPC | WGT | D3P |
            // | NONE | M  | CO | R   | MI  | TR  |   | X   | EC  | SW1 | SW2 | LF  | PIP |
            // | UNDO | SP | J  | BU  | BDF | FE  |   | DE  | PJ  | PU  | PRA | BZE | HED |
            //                        | hold CAD | LWR | ENTER/HYPER | SPACE | RSE | ALT |

            bindings = <
&m9_zs     &m9_rr  &m9_pp  &m9_gld  &m9_goc  &m9_gcu                            &m9_ggd    &m9_hal  &m9_pvl        &m9_mpc  &m9_wgt  &m9_d3p
&m9_sn     &m9_m   &m9_co  &m9_r    &m9_mi   &m9_tr                             &m9_x      &m9_ec   &m9_sw1        &m9_sw2  &m9_lf   &m9_pip
&kp LC(Z)  &m9_sp  &m9_j   &m9_bu   &m9_bdf  &m9_fe                             &m9_de     &m9_pj   &m9_pu         &m9_pra  &m9_bze  &m9_hed
                           &trans   &trans   &hmr LS(LA(LC(LEFT_GUI))) ENTER    &kp SPACE  &tog 2   &kp RIGHT_ALT
            >;
        };

        Bluetooth_Layer {
            bindings = <
&trans  &trans        &trans        &trans        &trans      &trans        &trans  &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_NXT  &bt BT_PRV    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans      &bt BT_CLR    &trans  &trans  &trans  &trans  &trans  &bt BT_CLR_ALL
                                    &trans        &trans      &trans        &trans  &trans  &trans
            >;
        };
    };
};
