#define ZMK_POINTING_DEFAULT_MOVE_VAL 1700
#define ZMK_POINTING_DEFAULT_SCRL_VAL 15

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include "custom_shortcut.dtsi"

/ {
    behaviors {
        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <290>;
            quick-tap-ms = <175>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <0 12 24 25 13 1 2 14 26 27 15 3 4 16 28 29 17 5 36 37 38 39 40 41 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;
            hold-trigger-on-release;
        };

        lower_layer: lower_layer {
            compatible = "zmk,behavior-hold-tap";
            label = "LOWER_LAYER";
            bindings = <&mo>, <&sl>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <0>;
            flavor = "balanced";
        };
    };

    combos {
        compatible = "zmk,combos";

        openlayer {
            bindings = <&mo 4>;
            key-positions = <37 40>;
            layers = <0>;
            slow-release;
        };
    };

    macros {
        sw1: sw1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp S &kp W &kp N1>;
            label = "SW1";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp TAB         &kp Q  &hmr LG(W) W  &kp E         &kp R                        &hmr LG(T) T        &kp Y  &kp U      &kp I          &kp O    &hmr F12 P  &kp BSPC
&kp LEFT_SHIFT  &kp A  &kp S         &kp D         &kp F                        &kp G               &kp H  &kp J      &kp K          &kp L    &kp SEMI    &kp SQT
&kp LCTRL       &kp Z  &kp X         &kp C         &kp V                        &kp B               &kp N  &kp M      &kp COMMA      &kp DOT  &kp FSLH    &hmr CAPSLOCK ESC
                                     &kp LEFT_WIN  &hmr LS(LA(LC(LCMD))) ENTER  &lower_layer 1 3    &mo 2  &kp SPACE  &kp RIGHT_ALT
            >;
        };

        lower_layer {
            bindings = <
&kp TAB  &hmr LG(LS(N1)) NUMBER_1  &hmr LG(LS(N2)) N2  &hmr LG(LS(N3)) N3  &hmr LG(LS(N4)) N4  &hmr LG(LS(N5)) N5       &kp N6           &kp N7         &kp N8       &kp N9        &kp N0           &kp DEL
&trans   &hmr END HOME             &kp GRAVE           &kp MINUS           &kp EQUAL           &kp NON_US_BACKSLASH     &kp LEFT_ARROW   &kp DOWN       &kp UP       &kp RIGHT     &kp LBKT         &kp RBKT
&trans   &kp LG(Z)                 &kp LG(X)           &kp LG(C)           &kp LG(V)           &kp LC(LS(LA(LG(B))))    &kp PRINTSCREEN  &kp PAGE_DOWN  &kp PAGE_UP  &kp C_VOL_DN  &kp C_VOLUME_UP  &kp K_MUTE
                                                       &trans              &trans              &trans                   &trans           &trans         &trans
            >;
        };

        raise_layer {
            bindings = <
&hmr F12 LC(TAB)  &kp F1            &kp F2     &kp F3        &kp F4     &kp F5             &kp F6          &kp F7          &kp F8           &kp F9           &kp F10    &hmr F11 BACKSPACE
&trans            &mkp MB4          &mkp MB5   &mkp LCLK     &mkp RCLK  &mkp MCLK          &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP     &mmv MOVE_RIGHT  &mkp LCLK  &mkp MCLK
&trans            &hmr LG(Y) LG(Z)  &kp LG(X)  &kp LG(C)     &kp LG(V)  &kp PRINTSCREEN    &mkp MB4        &msc SCRL_DOWN  &msc SCRL_UP     &mkp MB5         &mkp RCLK  &hmr CAPSLOCK ESC
                                               &kp LEFT_GUI  &trans     &trans             &trans          &msc SCRL_LEFT  &msc SCRL_RIGHT
            >;
        };

        cad_layer {
            bindings = <
&trans   &trans   &trans   &trans   &trans   &trans     &trans   &trans   &trans   &trans   &trans   &trans
&m9_gld  &m9_goc  &m9_gcu  &m9_ggd  &m9_hal  &m9_pvl    &m9_mpc  &m9_wgt  &m9_pip  &m9_pra  &m9_bze  &m9_hed
&trans   &trans   &trans   &m9_d3p  &m9_sw1  &m9_sw2    &trans   &trans   &trans   &trans   &trans   &trans
                           &trans   &trans   &trans     &trans   &trans   &trans
            >;
        };

        Bluetooth_Layer {
            bindings = <
&trans  &trans        &trans        &trans        &trans      &trans        &trans  &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_NXT  &bt BT_PRV    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans      &bt BT_CLR    &trans  &trans  &trans  &trans  &trans  &bt BT_CLR_ALL
                                    &trans        &trans      &trans        &trans  &trans  &trans
            >;
        };
    };
};

/* Pointing configuration must be outside the root node. */

&msc {
    acceleration-exponent = <2>;
    time-to-max-speed-ms = <100>;
};

&mmv {
    acceleration-exponent = <2>;
    time-to-max-speed-ms = <100>;
};
